{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "GameVault",
  "mainBinaryName": "GameVault",
  "identifier": "com.phalcode.gamevault",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "pnpm start",
    "beforeBuildCommand": "pnpm build"
  },
  "app": {
    "windows": [
      {
        "title": "GameVault",
        "width": 1280,
        "height": 720,
        "resizable": true,
        "fullscreen": false,
        "decorations": false,
        "devtools": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "app", "dmg", "appimage", "deb"],
    "publisher": "Phalcode",
    "license": "CC BY-NC-SA 4.0",
    "homepage": "https://gamevau.lt",
    "shortDescription": "The self-hosted gaming platform for DRM-free games",
    "longDescription": "GameVault is a self-hosted gaming platform for DRM-free games. It acts as a central hub for your game library, keeps metadata and box art up to date, and lets you stream or download your games to any client.",
    "category": "Game",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "perMachine"
      }
    },
    "linux": {
      "deb": {
        "desktopTemplate": "linux/gamevault.desktop.hbs",
        "changelog": "debian-changelog",
        "section": "games",
        "files": {
          "usr/share/doc/gamevault/copyright": "debian-copyright",
          "usr/share/doc/gamevault/changelog.Debian": "debian-changelog"
        }
      }
    }
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://github.com/Phalcode/gamevault-frontend/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
