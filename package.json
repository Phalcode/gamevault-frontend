{
  "name": "gamevault-frontend",
  "version": "17.0.0",
  "description": "the self-hosted gaming platform for drm-free games",
  "author": "Alkan Alper, Schäfer Philip GbR / Phalcode",
  "private": true,
  "license": "CC BY-NC-SA 4.0",
  "type": "module",
  "packageManager": "pnpm@10.29.3",
  "scripts": {
    "start": "vite --clearScreen false",
    "dev": "vite",
    "debug": "vite dev server",
    "tauridev": "tauri dev",
    "build": "vite build",
    "lint": "prettier --write . && eslint .",
    "postinstall": "rimraf ./src/api && openapi-generator-cli generate -g typescript-fetch -i https://gamevault.alfagun74.de/api/docs-yaml -o ./src/api --global-property models,supportingFiles -p enumPropertyNaming=snake_case -p modelPropertyNaming=snake_case"
  },
  "dependencies": {
    "@headlessui/react": "^2.2.10",
    "@heroicons/react": "^2.2.0",
    "@tailwindcss/vite": "^4.2.4",
    "@tauri-apps/api": "^2.11.0",
    "@tauri-apps/plugin-autostart": "^2",
    "@tauri-apps/plugin-dialog": "^2.7.1",
    "@tauri-apps/plugin-fs": "^2.5.1",
    "clsx": "^2.1.1",
    "motion": "^12.38.0",
    "react": "^19.2.5",
    "react-dom": "^19.2.5",
    "react-markdown": "^10.1.0",
    "react-router": "^7.14.2",
    "swetrix": "^4.4.0",
    "tailwindcss": "^4.2.4",
    "use-dark-mode": "^2.3.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@openapitools/openapi-generator-cli": "^2.32.0",
    "@tailwindcss/typography": "^0.5.20",
    "@tauri-apps/cli": "2.10.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.2.0",
    "eslint": "^9.39.4",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.4.26",
    "globals": "^17.6.0",
    "prettier": "3.8.0",
    "rimraf": "^6.1.3",
    "typescript": "^5.9.3",
    "vite": "^7.3.2",
    "vite-tsconfig-paths": "^6.1.1"
  }
}
